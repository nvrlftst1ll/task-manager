# ============================================================
# Task Manager — переменные окружения
# Обязательных переменных НЕТ: приложение работает без .env.
# ============================================================

# URL dev-сервера Vite. Устанавливается автоматически скриптом
# `npm run dev:electron` (cross-env). Вручную задаётся только
# при нестандартной конфигурации dev-окружения.
VITE_DEV_SERVER_URL=http://localhost:5173
